[36.229499, "o", "\r\n\u001b[1;36m# 4. Check the evidence by hand: the change's tests on the ORIGINAL code\u001b[0m\r\n"]
[37.230556, "o", "\u001b[1;32m$\u001b[0m git checkout agent/t20261009-c622f2 -- cart_test.go \r\n"]
