[38.351719, "o", "--- FAIL: TestTotalBulkDiscountAtExactlyTen (0.00s)\r\n    cart_test.go:19: Total = 1000, want 900\r\nFAIL\r\nFAIL\texample.com/shop\t0.001s\r\n?   \texample.com/shop/cmd/quote\t[no test files]\r\nFAIL\r\n"]
