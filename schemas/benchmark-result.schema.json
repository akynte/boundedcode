{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akynte/boundedcode/schemas/benchmark-result.schema.json",
  "title": "BoundedCode benchmark run result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_suite", "suite_hash", "task_id", "mode", "run_id", "pair_id", "configuration", "repository", "model", "environment", "execution", "system_result", "independent_evaluator", "derived", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_suite": {"type": "string"},
    "official": {"type": "boolean"},
    "smoke": {"type": "boolean"},
    "suite_version": {"type": "string"},
    "suite_hash": {"type": "string"},
    "manifest_hash": {"type": "string"},
    "task_id": {"type": "string"},
    "mode": {"enum": ["raw", "bounded"]},
    "run_index": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string"},
    "execution_id": {"type": "string"},
    "pair_id": {"type": "string"},
    "repetition": {"type": "integer", "minimum": 0},
    "benchmark_seed": {"type": "integer"},
    "timestamp": {"type": "string", "format": "date-time"},
    "task": {"type": "object"},
    "configuration": {"type": "object"},
    "repository": {"type": "object"},
    "model": {"type": "object"},
    "environment": {"type": "object"},
    "execution": {"type": "object"},
    "system_result": {"type": "object"},
    "independent_evaluator": {"type": "object"},
    "derived": {"type": "object"},
    "fingerprints": {"type": "object"},
    "status": {"enum": ["completed", "task_failed", "timeout", "infrastructure_error", "provider_unavailable", "evaluator_error", "evaluator_timeout", "invalid", "cancelled"]},
    "infrastructure_error": {"type": "string"},
    "events": {"type": "array"},
    "artifacts": {"type": "object"}
  }
}
