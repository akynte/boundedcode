{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akynte/boundedcode/schemas/benchmark-suite.schema.json",
  "title": "BoundedCode benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "model"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "official": {"type": "boolean"},
    "smoke": {"type": "boolean"},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "model": {"$ref": "#/$defs/model"},
    "runner": {"$ref": "#/$defs/runner"},
    "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"pattern": "(?i)(key|token|secret|password|credential|authorization|oracle|evaluator|hidden)"}}, "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "runtime": {"type": "string"},
        "model_file": {"type": "string"},
        "model_file_sha256": {"type": "string"},
        "quantization": {"type": "string"},
        "context_tokens": {"type": "integer", "minimum": 0},
        "temperature": {"type": "number"},
        "top_p": {"type": "number"},
        "top_k": {"type": "integer"},
        "seed": {"type": "integer"}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "config": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"pattern": "(?i)(key|token|secret|password|credential|authorization|oracle|evaluator|hidden)"}}, "additionalProperties": {"type": "string"}},
        "opencode_version": {"type": "string"},
        "concurrency": {"type": "integer", "minimum": 0},
        "cache_policy": {"type": "string"},
        "unattended_gate_policy": {"const": "permissive"}
      }
    }
  }
}
