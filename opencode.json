{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "bc-editor": {
      "description": "Supervised editing under BoundedCode. Verification, impact and memory come from the bc_* tools; this agent has no shell and no network.",
      "mode": "primary",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "execute": "deny",
        "external_directory": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "read": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 12000,
    "keep": {
      "tokens": 4000
    }
  },
  "tool_output": {
    "max_bytes": 8192,
    "max_lines": 200
  },
  "default_agent": "bc-editor",
  "mcp": {
    "servers": {
      "boundedcode": {
        "codemode": false,
        "command": [
          "bcode",
          "mcp"
        ],
        "disabled": false,
        "timeout": {
          "request": 1200000
        },
        "type": "local"
      }
    }
  },
  "model": "boundedcode-local/boundedcode-bonsai",
  "plugins": [
    "/home/ali/.local/share/boundedcode/workspaces/zkywzdguzxsbuoiebqd4nt43ue/opencode/opencode-plugin"
  ],
  "providers": {
    "boundedcode-local": {
      "models": {
        "boundedcode-bonsai": {
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "tools": true
          },
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "name": "boundedcode-bonsai"
        }
      },
      "name": "Local (via boundedcode)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      }
    }
  }
}
