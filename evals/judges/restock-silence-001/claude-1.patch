+// flakyItems fails GetItem for chosen SKUs, standing in for a catalogue that
+// is partly unreachable.
+type flakyItems struct {
+	store.ItemStore
+	fail map[domain.SKU]error
+}
+
+func (f flakyItems) GetItem(ctx context.Context, sku domain.SKU) (domain.Item, error) {
+	if err, ok := f.fail[sku]; ok {
+		return domain.Item{}, err
+	}
+	return f.ItemStore.GetItem(ctx, sku)
+}
+
+func TestReorderReportFlagsUnclassifiableSKUs(t *testing.T) {
+	_, mem := setup(t)
+	ctx := context.Background()
+	// CD-5678 is low and the catalogue lookup fails; EF-9012 is low and has no
+	// catalogue entry at all. Neither may be treated as "no reorder needed".
+	for _, sku := range []domain.SKU{"CD-5678", "EF-9012"} {
+		if err := mem.PutStock(ctx, store.Stock{SKU: sku, OnHand: 1}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := mem.PutItem(ctx, domain.Item{SKU: "CD-5678", Name: "Gadget"}); err != nil {
+		t.Fatal(err)
+	}
+	outage := errors.New("catalogue unavailable")
+	svc := New(mem, flakyItems{ItemStore: mem, fail: map[domain.SKU]error{"CD-5678": outage}})
+
+	skus, err := svc.ReorderReport(ctx, 20)
+	if len(skus) != 1 || skus[0] != "AB-1234" {
+		t.Fatalf("skus = %v, want [AB-1234]", skus)
+	}
+	var undet *UndeterminedError
+	if !errors.As(err, &undet) {
+		t.Fatalf("got %v, want *UndeterminedError", err)
+	}
+	if len(undet.SKUs) != 2 {
+		t.Fatalf("undetermined = %v, want CD-5678 and EF-9012", undet.SKUs)
+	}
+	if !errors.Is(err, outage) || !errors.Is(err, store.ErrNotFound) {
+		t.Fatalf("error %v does not wrap the underlying causes", err)
+	}
+}
+
+func TestReorderReportSkipsDiscontinued(t *testing.T) {
+	svc, mem := setup(t)
+	ctx := context.Background()
+	item, err := mem.GetItem(ctx, "AB-1234")
+	if err != nil {
+		t.Fatal(err)
+	}
+	item.Discontinued = true
+	if err := mem.PutItem(ctx, item); err != nil {
+		t.Fatal(err)
+	}
+	skus, err := svc.ReorderReport(ctx, 20)
+	if err != nil || len(skus) != 0 {
+		t.Fatalf("got %v, %v; want nothing and no error", skus, err)
+	}
+}
