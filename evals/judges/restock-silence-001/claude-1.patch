+// Undetermined is a SKU below the reorder threshold whose catalogue entry could
+// not be read, so the report cannot say whether it is still orderable.
+type Undetermined struct {
+	SKU domain.SKU
+	Err error
+}
+
+// UndeterminedError is returned by ReorderReport when some low SKUs could not
+// be classified. It is not the same as those SKUs being fine: each of them may
+// need reordering, and somebody has to look.
+type UndeterminedError struct {
+	SKUs []Undetermined
+}
+
+func (e *UndeterminedError) Error() string {
+	parts := make([]string, len(e.SKUs))
+	for i, u := range e.SKUs {
+		parts[i] = fmt.Sprintf("%s: %v", u.SKU, u.Err)
+	}
+	return fmt.Sprintf("inventory: cannot tell whether %d SKU(s) need reordering: %s",
+		len(e.SKUs), strings.Join(parts, "; "))
+}
+
+func (e *UndeterminedError) Unwrap() []error {
+	out := make([]error, len(e.SKUs))
+	for i, u := range e.SKUs {
+		out[i] = u.Err
+	}
+	return out
+}
+
 // ReorderReport lists SKUs whose available count has fallen below a threshold
 // and which are still orderable.
+//
+// A low SKU whose catalogue entry cannot be read is not silently dropped: the
+// SKUs that were classified are still returned, together with an
+// *UndeterminedError naming the ones that were not. Any other error means the
+// report could not be produced at all and the returned slice is nil.
 func (s *Service) ReorderReport(ctx context.Context, threshold int) ([]domain.SKU, error) {
 	rows, err := s.stock.ListStock(ctx)
 	if err != nil {
 		return nil, err
 	}
 	var out []domain.SKU
+	var undetermined []Undetermined
 	for _, row := range rows {
 		if row.Available() >= threshold {
 			continue
 		}
 		item, err := s.items.GetItem(ctx, row.SKU)
 		if err != nil {
+			if errors.Is(err, store.ErrNotFound) {
+				err = fmt.Errorf("stocked but not in the catalogue: %w", err)
+			}
+			undetermined = append(undetermined, Undetermined{SKU: row.SKU, Err: err})
 			continue
 		}
 		if item.Discontinued {
@@ -126,5 +168,8 @@ func (s *Service) ReorderReport(ctx context.Context, threshold int) ([]domain.SK
 		}
 		out = append(out, row.SKU)
 	}
+	if len(undetermined) > 0 {
+		return out, &UndeterminedError{SKUs: undetermined}
+	}
 	return out, nil
 }
