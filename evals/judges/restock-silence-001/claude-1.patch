@@ -0,0 +1,103 @@
+package worker
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"example.com/warehouse/internal/audit"
+	"example.com/warehouse/internal/domain"
+	"example.com/warehouse/internal/inventory"
+	"example.com/warehouse/internal/store"
+)
+
+// failingLog refuses to record events for chosen subjects.
+type failingLog struct {
+	*audit.MemoryLog
+	fail map[string]bool
+}
+
+var errLogDown = errors.New("audit log unavailable")
+
+func (l failingLog) Record(ctx context.Context, ev audit.Event) error {
+	if l.fail[ev.Subject] {
+		return errLogDown
+	}
+	return l.MemoryLog.Record(ctx, ev)
+}
+
+func lowStock(t *testing.T, catalogued bool, skus ...domain.SKU) *store.Memory {
+	t.Helper()
+	mem := store.NewMemory()
+	ctx := context.Background()
+	for _, sku := range skus {
+		if catalogued {
+			if err := mem.PutItem(ctx, domain.Item{SKU: sku, Name: string(sku)}); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := mem.PutStock(ctx, store.Stock{SKU: sku, OnHand: 1}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return mem
+}
+
+func actions(t *testing.T, log *audit.MemoryLog) map[string]string {
+	t.Helper()
+	evs, err := log.Since(context.Background(), time.Time{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	out := map[string]string{}
+	for _, ev := range evs {
+		out[ev.Subject] = ev.Action
+	}
+	return out
+}
+
+func TestRestockRecordsEveryLowSKU(t *testing.T) {
+	mem := lowStock(t, true, "AB-1234", "CD-5678")
+	log := audit.NewMemoryLog()
+	n, err := NewRestockWatcher(inventory.New(mem, mem), log, 5).RunOnce(context.Background())
+	if err != nil || n != 2 {
+		t.Fatalf("got %d, %v; want 2, nil", n, err)
+	}
+	got := actions(t, log)
+	if got["AB-1234"] != "restock.needed" || got["CD-5678"] != "restock.needed" {
+		t.Fatalf("audit = %v", got)
+	}
+}
+
+func TestRestockFailsWhenAlertNotRecorded(t *testing.T) {
+	mem := lowStock(t, true, "AB-1234", "CD-5678")
+	log := failingLog{MemoryLog: audit.NewMemoryLog(), fail: map[string]bool{"AB-1234": true}}
+	n, err := NewRestockWatcher(inventory.New(mem, mem), log, 5).RunOnce(context.Background())
+	if !errors.Is(err, errLogDown) {
+		t.Fatalf("got %v, want the audit failure", err)
+	}
+	if n != 2 {
+		t.Fatalf("n = %d, want 2", n)
+	}
+	// The other SKU's alert must still have been recorded.
+	if got := actions(t, log.MemoryLog); got["CD-5678"] != "restock.needed" {
+		t.Fatalf("audit = %v", got)
+	}
+}
+
+func TestRestockFailsWhenSKUCannotBeClassified(t *testing.T) {
+	mem := lowStock(t, false, "AB-1234")
+	log := audit.NewMemoryLog()
+	n, err := NewRestockWatcher(inventory.New(mem, mem), log, 5).RunOnce(context.Background())
+	var undet *inventory.UndeterminedError
+	if !errors.As(err, &undet) {
+		t.Fatalf("got %v, want *inventory.UndeterminedError", err)
+	}
+	if n != 0 {
+		t.Fatalf("n = %d, want 0", n)
+	}
+	if got := actions(t, log); got["AB-1234"] != "restock.undetermined" {
+		t.Fatalf("audit = %v, want AB-1234 recorded as undetermined", got)
+	}
+}
