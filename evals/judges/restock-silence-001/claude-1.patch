 // RunOnce makes one pass and returns how many SKUs need reordering.
+//
+// The audit record is the alert, so a pass only succeeds if every SKU that
+// needs reordering was recorded and every low SKU could be classified. Anything
+// short of that returns an error naming what was missed, alongside the count of
+// SKUs known to need reordering. SKUs that could not be classified are recorded
+// as restock.undetermined so they show up in the log rather than being absent.
 func (w *RestockWatcher) RunOnce(ctx context.Context) (int, error) {
 	skus, err := w.inventory.ReorderReport(ctx, w.threshold)
-	if err != nil {
+	var undetermined *inventory.UndeterminedError
+	if err != nil && !errors.As(err, &undetermined) {
 		return 0, err
 	}
+
+	var failures []error
 	for _, sku := range skus {
-		_ = w.audit.Record(ctx, audit.Event{
+		if err := w.audit.Record(ctx, audit.Event{
 			Actor: "restock", Action: "restock.needed", Subject: sku.String(),
 			Detail: map[string]string{"threshold": fmt.Sprint(w.threshold)},
-		})
+		}); err != nil {
+			failures = append(failures, fmt.Errorf("alert for %s not recorded: %w", sku, err))
+		}
+	}
+	if undetermined != nil {
+		for _, u := range undetermined.SKUs {
+			if err := w.audit.Record(ctx, audit.Event{
+				Actor: "restock", Action: "restock.undetermined", Subject: u.SKU.String(),
+				Detail: map[string]string{
+					"threshold": fmt.Sprint(w.threshold),
+					"error":     u.Err.Error(),
+				},
+			}); err != nil {
+				failures = append(failures,
+					fmt.Errorf("undetermined %s not recorded: %w", u.SKU, err))
+			}
+		}
+		failures = append(failures, undetermined)
+	}
+
+	if len(failures) > 0 {
+		return len(skus), fmt.Errorf("restock: pass incomplete (%d SKU(s) need reordering): %w",
+			len(skus), errors.Join(failures...))
 	}
 	return len(skus), nil
 }
