@@ -0,0 +1,40 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"example.com/warehouse/internal/store"
+)
+
+func TestWriteErrorVersionConflictIsRetryable409(t *testing.T) {
+	for _, err := range []error{
+		store.ErrConflict,
+		fmt.Errorf("inventory: reserve: %w", store.ErrConflict),
+	} {
+		rec := httptest.NewRecorder()
+		writeError(rec, err)
+		if rec.Code != http.StatusConflict {
+			t.Fatalf("writeError(%v) status = %d, want %d", err, rec.Code, http.StatusConflict)
+		}
+		var body map[string]string
+		if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
+			t.Fatalf("decode body: %v", err)
+		}
+		if body["error"] != "concurrent update, please retry" {
+			t.Fatalf("error = %q", body["error"])
+		}
+	}
+}
+
+func TestWriteErrorUnknownIs500(t *testing.T) {
+	rec := httptest.NewRecorder()
+	writeError(rec, errors.New("disk on fire"))
+	if rec.Code != http.StatusInternalServerError {
+		t.Fatalf("status = %d, want %d", rec.Code, http.StatusInternalServerError)
+	}
+}
