diff --git a/internal/worker/reconcile.go b/internal/worker/reconcile.go
index dda2ed5..626d28e 100644
--- a/internal/worker/reconcile.go
+++ b/internal/worker/reconcile.go
@@ -14,21 +14,31 @@ import (
 	"example.com/warehouse/internal/store"
 )
 
+// ReleaseGrace is how long after a cancellation the reconciler leaves the
+// order alone, so that it does not race the cancellation's own release.
+const ReleaseGrace = 5 * time.Minute
+
 // Reconciler corrects reservations that outlived their orders. A reservation
 // belonging to a cancelled order holds stock nobody can buy, which is the most
 // expensive kind of bug this service has.
+//
+// Only lines still marked ReleasePending are released. Releasing a line that
+// was already released takes the units from some other, live order's
+// reservation, which is just as expensive in the other direction.
 type Reconciler struct {
 	orders    store.OrderStore
 	stock     store.StockStore
 	inventory *inventory.Service
 	audit     audit.Log
 	now       func() time.Time
+	grace     time.Duration
 }
 
 // NewReconciler builds a reconciler.
 func NewReconciler(orders store.OrderStore, stock store.StockStore,
 	inv *inventory.Service, log audit.Log) *Reconciler {
-	return &Reconciler{orders: orders, stock: stock, inventory: inv, audit: log, now: time.Now}
+	return &Reconciler{orders: orders, stock: stock, inventory: inv, audit: log,
+		now: time.Now, grace: ReleaseGrace}
 }
 
 // Report is what one pass changed.
@@ -48,23 +58,29 @@ func (r *Reconciler) RunOnce(ctx context.Context) (Report, error) {
 	}
 	rep.OrdersExamined = len(cancelled)
 
+	cutoff := r.now().Add(-r.grace)
 	for _, order := range cancelled {
-		for _, line := range order.Lines {
-			st, err := r.stock.GetStock(ctx, line.SKU)
-			if err != nil {
-				rep.Discrepancies = append(rep.Discrepancies,
-					fmt.Sprintf("order %s line %s: %v", order.ID, line.SKU, err))
-				continue
-			}
-			if st.Reserved <= 0 {
+		if !order.PendingReleases() || order.CancelledAt.After(cutoff) {
+			continue
+		}
+		for i, line := range order.Lines {
+			if !line.ReleasePending {
 				continue
 			}
 			if err := r.inventory.Release(ctx, line.SKU, line.Quantity); err != nil {
 				rep.Discrepancies = append(rep.Discrepancies,
-					fmt.Sprintf("releasing %s: %v", line.SKU, err))
+					fmt.Sprintf("order %s releasing %s: %v", order.ID, line.SKU, err))
 				continue
 			}
 			rep.ReservationsFreed += line.Quantity
+			order.Lines[i].ReleasePending = false
+			if err := r.orders.PutOrder(ctx, order); err != nil {
+				// The units are back in the pool but the order still says they
+				// are owed; stop here rather than widen the gap.
+				rep.Discrepancies = append(rep.Discrepancies,
+					fmt.Sprintf("order %s recording release of %s: %v", order.ID, line.SKU, err))
+				break
+			}
 		}
 	}
 
diff --git a/internal/worker/reconcile_test.go b/internal/worker/reconcile_test.go
new file mode 100644
index 0000000..aeeaef1
--- /dev/null
+++ b/internal/worker/reconcile_test.go
@@ -0,0 +1,165 @@
+package worker
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"example.com/warehouse/internal/audit"
+	"example.com/warehouse/internal/domain"
+	"example.com/warehouse/internal/inventory"
+	"example.com/warehouse/internal/notify"
+	"example.com/warehouse/internal/orders"
+	"example.com/warehouse/internal/pricing"
+	"example.com/warehouse/internal/shipping"
+	"example.com/warehouse/internal/store"
+)
+
+const sku domain.SKU = "AB-1234"
+
+type fixture struct {
+	mem        *store.Memory
+	inv        *inventory.Service
+	orders     *orders.Service
+	reconciler *Reconciler
+}
+
+func setup(t *testing.T) fixture {
+	t.Helper()
+	mem := store.NewMemory()
+	ctx := context.Background()
+	if err := mem.PutItem(ctx, domain.Item{
+		SKU: sku, Name: "Widget", Category: domain.CategoryGeneral,
+		UnitPrice: domain.NewMoney(1000, domain.GBP), WeightGram: 500,
+		Dimensions: domain.Dimensions{LengthMM: 100, WidthMM: 100, HeightMM: 50},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := mem.PutStock(ctx, store.Stock{SKU: sku, OnHand: 20}); err != nil {
+		t.Fatal(err)
+	}
+	inv := inventory.New(mem, mem)
+	log := audit.NewMemoryLog()
+	svc := orders.New(mem, mem, inv,
+		pricing.New(mem, 2000),
+		shipping.New(mem, shipping.DefaultZones()...),
+		log, notify.New(notify.NewRecorder()),
+	)
+	rec := NewReconciler(mem, mem, inv, log)
+	// Every order in these tests is long past the grace period.
+	rec.now = func() time.Time { return time.Now().Add(time.Hour) }
+	return fixture{mem: mem, inv: inv, orders: svc, reconciler: rec}
+}
+
+func (f fixture) place(t *testing.T, id domain.OrderID, qty int) {
+	t.Helper()
+	if _, _, err := f.orders.Place(context.Background(), orders.PlaceRequest{
+		OrderID: id, CustomerID: "c1", Currency: domain.GBP, CountryCode: "GB",
+		Lines: []orders.RequestLine{{SKU: sku, Quantity: qty}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (f fixture) reserved(t *testing.T) int {
+	t.Helper()
+	st, err := f.mem.GetStock(context.Background(), sku)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return st.Reserved
+}
+
+func TestReconcileLeavesLiveReservationsAlone(t *testing.T) {
+	f := setup(t)
+	ctx := context.Background()
+	f.place(t, "live", 5)
+	for _, id := range []domain.OrderID{"gone1", "gone2", "gone3"} {
+		f.place(t, id, 2)
+		if err := f.orders.Cancel(ctx, id, "changed mind"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for pass := 0; pass < 3; pass++ {
+		rep, err := f.reconciler.RunOnce(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if rep.ReservationsFreed != 0 {
+			t.Fatalf("pass %d freed %d units, want 0", pass, rep.ReservationsFreed)
+		}
+	}
+	if got := f.reserved(t); got != 5 {
+		t.Fatalf("reserved = %d, want the live order's 5", got)
+	}
+}
+
+func TestReconcileRecoversAnOrphanedReservationOnce(t *testing.T) {
+	f := setup(t)
+	ctx := context.Background()
+	f.place(t, "live", 5)
+	f.place(t, "orphan", 3)
+
+	// A cancellation that was saved but whose release never happened.
+	order, err := f.mem.GetOrder(ctx, "orphan")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := order.Transition(domain.StateCancelled); err != nil {
+		t.Fatal(err)
+	}
+	order.CancelledAt = time.Now()
+	for i := range order.Lines {
+		order.Lines[i].ReleasePending = true
+	}
+	if err := f.mem.PutOrder(ctx, order); err != nil {
+		t.Fatal(err)
+	}
+
+	rep, err := f.reconciler.RunOnce(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rep.ReservationsFreed != 3 {
+		t.Fatalf("freed %d, want 3", rep.ReservationsFreed)
+	}
+	if got := f.reserved(t); got != 5 {
+		t.Fatalf("reserved = %d after recovery, want 5", got)
+	}
+
+	rep, err = f.reconciler.RunOnce(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rep.ReservationsFreed != 0 || f.reserved(t) != 5 {
+		t.Fatalf("second pass freed %d, reserved now %d; want 0 and 5",
+			rep.ReservationsFreed, f.reserved(t))
+	}
+}
+
+func TestReconcileWaitsOutTheGracePeriod(t *testing.T) {
+	f := setup(t)
+	ctx := context.Background()
+	f.place(t, "orphan", 3)
+	order, err := f.mem.GetOrder(ctx, "orphan")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := order.Transition(domain.StateCancelled); err != nil {
+		t.Fatal(err)
+	}
+	order.CancelledAt = time.Now()
+	order.Lines[0].ReleasePending = true
+	if err := f.mem.PutOrder(ctx, order); err != nil {
+		t.Fatal(err)
+	}
+
+	f.reconciler.now = time.Now
+	rep, err := f.reconciler.RunOnce(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rep.ReservationsFreed != 0 || f.reserved(t) != 3 {
+		t.Fatalf("freed %d inside the grace period, want 0", rep.ReservationsFreed)
+	}
+}
