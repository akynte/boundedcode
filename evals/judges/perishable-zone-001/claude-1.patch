+func TestQuoteRefusesPerishableAbroad(t *testing.T) {
+	mem := store.NewMemory()
+	ctx := context.Background()
+	_ = mem.PutItem(ctx, domain.Item{
+		SKU: "FD-1234", Category: domain.CategoryPerishable, WeightGram: 300,
+		UnitPrice: domain.NewMoney(100, domain.GBP),
+	})
+	s := New(mem, DefaultZones()...)
+	_, err := s.Quote(ctx, domain.Order{
+		Currency: domain.GBP, ShippingZone: "eu",
+		Lines: []domain.OrderLine{{SKU: "FD-1234", Quantity: 1, UnitPrice: domain.NewMoney(100, domain.GBP)}},
+	})
+	if !errors.Is(err, ErrNoCarrier) {
+		t.Fatalf("got %v, want ErrNoCarrier", err)
+	}
+}
