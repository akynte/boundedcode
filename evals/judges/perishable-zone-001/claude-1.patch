+func TestRateRefusesPerishableOutsideRefrigeratedZone(t *testing.T) {
+	s := New(store.NewMemory(), DefaultZones()...)
+	for _, country := range []string{"FR", "US"} {
+		z, _ := s.ZoneFor(country)
+		_, err := s.Rate(z, Parcel{WeightGram: 500, ContainsPerishable: true}, domain.GBP)
+		if !errors.Is(err, ErrNoColdChain) {
+			t.Fatalf("%s: got %v, want ErrNoColdChain", country, err)
+		}
+		// Callers that map ErrNoCarrier to a refusal must see this one too.
+		if !errors.Is(err, ErrNoCarrier) {
+			t.Fatalf("%s: got %v, want it to wrap ErrNoCarrier", country, err)
+		}
+	}
+}
+
+func TestRateAcceptsPerishableDomestically(t *testing.T) {
+	s := New(store.NewMemory(), DefaultZones()...)
+	z, _ := s.ZoneFor("GB")
+	if _, err := s.Rate(z, Parcel{WeightGram: 500, ContainsPerishable: true}, domain.GBP); err != nil {
+		t.Fatal(err)
+	}
+}
