 }
 
-// StockStore holds on-hand and reserved counts per SKU.
+// StockStore holds on-hand, reserved and damaged counts per SKU.
 type StockStore interface {
 	GetStock(ctx context.Context, sku domain.SKU) (Stock, error)
 	PutStock(ctx context.Context, stock Stock) error
@@ -40,12 +40,25 @@ type StockStore interface {
 
 // Stock is the warehouse's count for one SKU.
 type Stock struct {
-	SKU      domain.SKU
+	SKU domain.SKU
+	// OnHand is every unit physically in the building, damaged or not.
 	OnHand   int
 	Reserved int
+	// Damaged units are on the premises, and so included in OnHand, but
+	// cannot be sold: crushed boxes, split seals, expired date codes.
+	Damaged int
 	// Version guards against a lost update when two reservations race.
 	Version int
 }
 
-// Available is what can still be promised to a new order.
-func (s Stock) Available() int { return s.OnHand - s.Reserved }
+// Sellable is the number of undamaged units on hand, reserved or not.
+func (s Stock) Sellable() int { return s.OnHand - s.Damaged }
+
+// Available is what can still be promised to a new order. It never goes below
+// zero: units damaged after they were reserved leave nothing to promise, not a
+// negative amount.
+func (s Stock) Available() int { return max(s.Sellable()-s.Reserved, 0) }
+
+// Overcommitted is how many reserved units have no undamaged unit behind them,
+// which happens when stock is marked damaged after it was promised.
+func (s Stock) Overcommitted() int { return max(s.Reserved-s.Sellable(), 0) }
