@@ -68,11 +68,27 @@ func (r *Reconciler) RunOnce(ctx context.Context) (Report, error) {
 		}
 	}
 
+	// Stock marked damaged after it was reserved leaves customers promised
+	// units that cannot be shipped. Nothing here can fix that automatically,
+	// so it is reported for a human to resolve.
+	rows, err := r.stock.ListStock(ctx)
+	if err != nil {
+		return rep, err
+	}
+	for _, st := range rows {
+		if n := st.Overcommitted(); n > 0 {
+			rep.Discrepancies = append(rep.Discrepancies,
+				fmt.Sprintf("stock %s: %d reserved but only %d undamaged on hand (%d damaged)",
+					st.SKU, st.Reserved, st.Sellable(), st.Damaged))
+		}
+	}
+
 	_ = r.audit.Record(ctx, audit.Event{
 		Actor: "reconciler", Action: "reconcile.pass", Subject: "stock",
 		Detail: map[string]string{
 			"orders_examined": fmt.Sprint(rep.OrdersExamined),
 			"freed":           fmt.Sprint(rep.ReservationsFreed),
+			"discrepancies":   fmt.Sprint(len(rep.Discrepancies)),
 		},
 	})
 	return rep, nil
