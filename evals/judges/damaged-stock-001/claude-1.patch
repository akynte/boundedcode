+// SetDamaged records how many of a SKU's on-hand units are unsellable. It sets
+// the count rather than adding to it, so a recount corrects the figure outright.
+// The units stay in OnHand, because they are still in the building; they simply
+// stop being available to promise.
+func (s *Service) SetDamaged(ctx context.Context, sku domain.SKU, count int) error {
+	if count < 0 {
+		return fmt.Errorf("inventory: damaged count must not be negative, got %d", count)
+	}
+	st, err := s.stock.GetStock(ctx, sku)
+	if err != nil {
+		return err
+	}
+	if count > st.OnHand {
+		return fmt.Errorf("inventory: %s has %d on hand, cannot mark %d damaged",
+			sku, st.OnHand, count)
+	}
+	st.Damaged = count
+	return s.stock.PutStock(ctx, st)
+}
