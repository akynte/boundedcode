+package worker
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"example.com/warehouse/internal/audit"
+	"example.com/warehouse/internal/domain"
+	"example.com/warehouse/internal/inventory"
+	"example.com/warehouse/internal/store"
+)
+
+func TestReconcileReportsReservationsLostToDamage(t *testing.T) {
+	ctx := context.Background()
+	mem := store.NewMemory()
+	item := domain.Item{
+		SKU: "AB-1234", Name: "Widget", Category: domain.CategoryGeneral,
+		UnitPrice: domain.NewMoney(500, domain.GBP), WeightGram: 250,
+	}
+	if err := mem.PutItem(ctx, item); err != nil {
+		t.Fatal(err)
+	}
+	if err := mem.PutStock(ctx, store.Stock{SKU: "AB-1234", OnHand: 10}); err != nil {
+		t.Fatal(err)
+	}
+	inv := inventory.New(mem, mem)
+	if err := inv.Reserve(ctx, "AB-1234", 8); err != nil {
+		t.Fatal(err)
+	}
+	if err := inv.SetDamaged(ctx, "AB-1234", 5); err != nil {
+		t.Fatal(err)
+	}
+
+	rep, err := NewReconciler(mem, mem, inv, audit.NewMemoryLog()).RunOnce(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rep.Discrepancies) != 1 || !strings.Contains(rep.Discrepancies[0], "AB-1234") {
+		t.Fatalf("discrepancies = %v, want one for AB-1234", rep.Discrepancies)
+	}
+}
