diff --git a/internal/billing/total.go b/internal/billing/total.go
index 38866b9..a1507c3 100644
--- a/internal/billing/total.go
+++ b/internal/billing/total.go
@@ -7,14 +7,12 @@ type Line struct {
 	Quantity    int
 }
 
-// Total returns the invoice total in pence.
-//
-// It ignores currency entirely, which is the problem: the business now sells
-// in more than one.
-func Total(lines []Line) int {
+// Total returns the invoice total in pence together with the currency code
+// the lines are priced in.
+func Total(lines []Line, currency string) (int, string) {
 	total := 0
 	for _, l := range lines {
 		total += l.PenceEach * l.Quantity
 	}
-	return total
+	return total, currency
 }
diff --git a/internal/billing/total_test.go b/internal/billing/total_test.go
index 66974ad..3643195 100644
--- a/internal/billing/total_test.go
+++ b/internal/billing/total_test.go
@@ -4,7 +4,8 @@ import "testing"
 
 func TestTotal(t *testing.T) {
 	lines := []Line{{PenceEach: 100, Quantity: 2}, {PenceEach: 50, Quantity: 1}}
-	if got := Total(lines); got != 250 {
-		t.Fatalf("got %d", got)
+	got, currency := Total(lines, "GBP")
+	if got != 250 || currency != "GBP" {
+		t.Fatalf("got %d %s", got, currency)
 	}
 }
