+// quantitiesBySKU totals an order's lines per SKU, in first-seen order. An
+// order holds one reservation per SKU, so two lines for the same SKU must be
+// reserved, released and consumed together rather than mistaken for a repeat.
+func quantitiesBySKU(lines []domain.OrderLine) []RequestLine {
+	var out []RequestLine
+	index := map[domain.SKU]int{}
+	for _, l := range lines {
+		if i, ok := index[l.SKU]; ok {
+			out[i].Quantity += l.Quantity
+			continue
+		}
+		index[l.SKU] = len(out)
+		out = append(out, RequestLine{SKU: l.SKU, Quantity: l.Quantity})
+	}
+	return out
+}
