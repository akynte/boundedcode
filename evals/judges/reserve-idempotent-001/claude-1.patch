+// cloneStock copies the Holds map so a caller editing a row it has read cannot
+// change the stored row without going through PutStock's version check.
+func cloneStock(s Stock) Stock {
+	if s.Holds != nil {
+		s.Holds = maps.Clone(s.Holds)
+	}
+	return s
+}
