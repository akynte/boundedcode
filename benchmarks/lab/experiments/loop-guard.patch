+// repeatExempt are tools whose repeats are expected: polling a background
+// command for more output.
+var repeatExempt = map[string]bool{"bash_output": true}
+
+// repeatRefusal says why a call is not run again ("" when it may run): it
+// ran twice already with no change since.
+func (r *Runner) repeatRefusal(c ToolCall) string {
+	if repeatExempt[c.Function.Name] || r.seenCalls[c.Function.Name+"\x00"+c.Function.Arguments] < 2 {
+		return ""
+	}
+	return "not run: this exact call already ran twice with nothing changed since, and its result is above. Use that result, change the arguments, or answer from what you have."
+}
+
+// noteCall counts a call that ran. A call that can change files starts
+// the count again for every other call.
+func (r *Runner) noteCall(c ToolCall) {
+	key := c.Function.Name + "\x00" + c.Function.Arguments
+	if t := r.findTool(c.Function.Name); t != nil && t.Mutates {
+		n := r.seenCalls[key]
+		r.seenCalls = map[string]int{key: n}
+	}
+	if r.seenCalls == nil {
+		r.seenCalls = map[string]int{}
+	}
+	r.seenCalls[key]++
+}
