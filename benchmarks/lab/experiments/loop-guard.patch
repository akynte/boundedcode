+++ b/internal/direct/loopguard_test.go
@@ -0,0 +1,59 @@
+package direct
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// The third identical call with nothing changed since is not run, and after
+// three such refusals the model is asked for its answer. A change starts
+// the count again.
+func TestRepeatGuard(t *testing.T) {
+	rd := call{"read", map[string]any{"path": "a.txt"}}
+	up := &scripted{replies: []reply{
+		{calls: []call{rd}}, {calls: []call{rd}}, {calls: []call{rd}}, {calls: []call{rd}}, {calls: []call{rd}},
+		{text: "the answer"},
+	}}
+	r, root, _ := newRunner(t, up, ApprovalAuto)
+	if err := os.WriteFile(filepath.Join(root, "a.txt"), []byte("hello\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	out, err := r.Send(context.Background(), "read a.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != "the answer" {
+		t.Fatalf("answer %q", out)
+	}
+	var refused, asked int
+	for _, m := range r.Session.Messages {
+		if m.Role == "tool" && strings.Contains(m.Content, "already ran twice") {
+			refused++
+		}
+		if m.Role == "user" && strings.Contains(m.Content, "keep repeating calls") {
+			asked++
+		}
+	}
+	if refused != 3 || asked != 1 {
+		t.Fatalf("refused %d, asked %d", refused, asked)
+	}
+
+	// read, edit, read, read: the edit resets the count, so nothing is refused.
+	ed := call{"edit", map[string]any{"path": "a.txt", "old_string": "hello", "new_string": "bye"}}
+	up2 := &scripted{replies: []reply{{calls: []call{rd}}, {calls: []call{rd}}, {calls: []call{ed}}, {calls: []call{rd}}, {calls: []call{rd}}, {text: "ok"}}}
+	r2, root2, _ := newRunner(t, up2, ApprovalAuto)
+	if err := os.WriteFile(filepath.Join(root2, "a.txt"), []byte("hello\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r2.Send(context.Background(), "edit a.txt"); err != nil {
+		t.Fatal(err)
+	}
+	for _, m := range r2.Session.Messages {
+		if strings.Contains(m.Content, "already ran twice") {
+			t.Fatalf("refused after a change: %q", m.Content)
+		}
+	}
+}
