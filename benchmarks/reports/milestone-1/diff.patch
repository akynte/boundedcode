+
+func TestCreatePaymentIdempotency(t *testing.T) {
+	mux, prod := newTestServer()
+	body := `{"account_id":"acc_1","amount_cents":500,"currency":"EUR"}`
+
+	// First request with idempotency key
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest("POST", "/v1/payments", strings.NewReader(body))
+	req.Header.Set("Idempotency-Key", "key-1")
+	mux.ServeHTTP(rec, req)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("first request status = %d", rec.Code)
+	}
+	var firstResp map[string]interface{}
+	_ = json.NewDecoder(rec.Body).Decode(&firstResp)
+	payID1 := firstResp["id"]
+
+	// Second request with same idempotency key
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest("POST", "/v1/payments", strings.NewReader(body))
+	req.Header.Set("Idempotency-Key", "key-1")
+	mux.ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("second request status = %d", rec.Code)
+	}
+	var secondResp map[string]interface{}
+	_ = json.NewDecoder(rec.Body).Decode(&secondResp)
+	payID2 := secondResp["id"]
+
+	if payID1 != payID2 {
+		t.Errorf("same idempotency key returned different IDs: %s vs %s", payID1, payID2)
+	}
+
+	// Only one event should be published
+	if len(prod.Sent) != 1 {
+		t.Errorf("events published = %d, want 1", len(prod.Sent))
+	}
+}
+
+func TestCreatePaymentDifferentKeys(t *testing.T) {
+	mux, prod := newTestServer()
+	body := `{"account_id":"acc_1","amount_cents":500,"currency":"EUR"}`
+
+	// Two requests with different idempotency keys
+	for _, key := range []string{"key-a", "key-b"} {
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest("POST", "/v1/payments", strings.NewReader(body))
+		req.Header.Set("Idempotency-Key", key)
+		mux.ServeHTTP(rec, req)
+		if rec.Code != http.StatusCreated {
+			t.Fatalf("key %s: status = %d", key, rec.Code)
+		}
+	}
+
+	// Two events should be published
+	if len(prod.Sent) != 2 {
+		t.Errorf("events published = %d, want 2", len(prod.Sent))
+	}
+}
+
+func TestCreatePaymentNoHeader(t *testing.T) {
+	mux, prod := newTestServer()
+	body := `{"account_id":"acc_1","amount_cents":500,"currency":"EUR"}`
+
+	// Request without idempotency key
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/payments", strings.NewReader(body)))
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d", rec.Code)
+	}
+	if len(prod.Sent) != 1 {
+		t.Errorf("events published = %d, want 1", len(prod.Sent))
+	}
+}
