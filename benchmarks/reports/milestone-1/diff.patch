@@ -0,0 +1,33 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestHiddenIdempotencyKey(t *testing.T) {
+	mux, prod := newTestServer()
+	ids := map[string]bool{}
+	for i := 0; i < 3; i++ {
+		req := httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"a","amount_cents":10,"currency":"EUR"}`))
+		req.Header.Set("Idempotency-Key", "k-1")
+		rec := httptest.NewRecorder()
+		mux.ServeHTTP(rec, req)
+		if rec.Code != 200 && rec.Code != 201 {
+			t.Fatalf("status %d", rec.Code)
+		}
+		var p struct{ ID string }
+		_ = json.Unmarshal(rec.Body.Bytes(), &p)
+		ids[p.ID] = true
+	}
+	if len(ids) != 1 || len(prod.Sent) != 1 {
+		t.Fatalf("ids=%v events=%d", ids, len(prod.Sent))
+	}
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"a","amount_cents":10,"currency":"EUR"}`)))
+	if len(prod.Sent) != 2 {
+		t.Fatalf("request without key should publish: events=%d", len(prod.Sent))
+	}
+}

