+}
+
+// NewHandler returns a Handler with initialized idempotency map.
+func NewHandler(s *store.Store, e *events.Publisher) *Handler {
+	return &Handler{
+		Store:          s,
+		Events:         e,
+		idempotencyMap: make(map[string]idempotentResult),
+	}
