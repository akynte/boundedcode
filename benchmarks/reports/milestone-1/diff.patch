+func TestHandlePaymentChargedIdempotent(t *testing.T) {
+	l := &ledger.Ledger{}
+	c := &Consumer{Ledger: l}
+	msg := &ConsumerMessage{Topic: TopicPaymentCharged, Value: []byte(`{"payment_id":"p1","account_id":"a1","amount_cents":500,"currency":"EUR"}`)}
+
+	// Process the same event twice
+	if err := c.HandlePaymentCharged(msg); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.HandlePaymentCharged(msg); err != nil {
+		t.Fatal(err)
+	}
+
+	// Balance should only reflect one posting
+	if got := l.Balance("a1"); got != 500 {
+		t.Fatalf("balance = %d, want 500", got)
+	}
+	if got := l.Balance(SettlementAccount); got != -500 {
+		t.Fatalf("settlement = %d, want -500", got)
+	}
+
+	// Only 2 entries total (one pair), not 4
+	if got := len(l.Entries()); got != 2 {
+		t.Fatalf("entries count = %d, want 2", got)
+	}
+}
