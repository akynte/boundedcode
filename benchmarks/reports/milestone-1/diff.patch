 // Ledger stores entries in memory (stand-in for SQL).
 type Ledger struct {
-	mu      sync.Mutex
-	entries []Entry
+	mu             sync.Mutex
+	entries        []Entry
+	postedPayments map[string]struct{}
 }
 
 // ErrUnbalanced is returned when entries do not sum to zero.
 var ErrUnbalanced = errors.New("unbalanced posting")
 
+// HasPosted reports whether entries for the given payment_id have already been posted.
+func (l *Ledger) HasPosted(paymentID string) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	_, ok := l.postedPayments[paymentID]
+	return ok
+}
+
 // Post records a balanced set of entries:
 // INSERT INTO ledger_entries (payment_id, account_id, amount_cents, currency) VALUES ...
 func (l *Ledger) Post(entries ...Entry) error {
@@ -35,7 +44,18 @@ func (l *Ledger) Post(entries ...Entry) error {
 	}
 	l.mu.Lock()
 	defer l.mu.Unlock()
+	for _, e := range entries {
+		if _, ok := l.postedPayments[e.PaymentID]; ok {
+			return nil
+		}
+	}
 	l.entries = append(l.entries, entries...)
+	for _, e := range entries {
+		if l.postedPayments == nil {
+			l.postedPayments = make(map[string]struct{})
+		}
+		l.postedPayments[e.PaymentID] = struct{}{}
+	}
 	return nil
 }
 
