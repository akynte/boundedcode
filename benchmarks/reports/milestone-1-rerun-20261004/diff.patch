@@ -0,0 +1,62 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestHiddenIdempotencyKey(t *testing.T) {
+	mux, prod := newTestServer()
+	ids := map[string]bool{}
+	for i := 0; i < 3; i++ {
+		req := httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"a","amount_cents":10,"currency":"EUR"}`))
+		req.Header.Set("Idempotency-Key", "k-1")
+		rec := httptest.NewRecorder()
+		mux.ServeHTTP(rec, req)
+		if rec.Code != 200 && rec.Code != 201 {
+			t.Fatalf("status %d", rec.Code)
+		}
+		var p struct{ ID string }
+		_ = json.Unmarshal(rec.Body.Bytes(), &p)
+		ids[p.ID] = true
+	}
+	if len(ids) != 1 || len(prod.Sent) != 1 {
+		t.Fatalf("ids=%v events=%d", ids, len(prod.Sent))
+	}
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"a","amount_cents":10,"currency":"EUR"}`)))
+	if len(prod.Sent) != 2 {
+		t.Fatalf("request without key should publish: events=%d", len(prod.Sent))
+	}
+}
+
+// Concurrent retries with the same key (a real client timeout/retry race)
+// must still produce exactly one payment and one event.
+func TestHiddenIdempotencyKeyConcurrent(t *testing.T) {
+	mux, prod := newTestServer()
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	ids := map[string]bool{}
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			req := httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"a","amount_cents":10,"currency":"EUR"}`))
+			req.Header.Set("Idempotency-Key", "k-race")
+			rec := httptest.NewRecorder()
+			mux.ServeHTTP(rec, req)
+			var p struct{ ID string }
+			_ = json.Unmarshal(rec.Body.Bytes(), &p)
+			mu.Lock()
+			ids[p.ID] = true
+			mu.Unlock()
+		}()
+	}
+	wg.Wait()
+	if len(ids) != 1 || len(prod.Sent) != 1 {
+		t.Fatalf("concurrent same-key requests: ids=%d events=%d", len(ids), len(prod.Sent))
+	}
+}

