+func TestHandlePaymentChargedIdempotent(t *testing.T) {
+	l := &ledger.Ledger{}
+	c := &Consumer{Ledger: l}
+	msg := &ConsumerMessage{Topic: TopicPaymentCharged, Value: []byte(`{"payment_id":"p1","account_id":"a1","amount_cents":500,"currency":"EUR"}`)}
+
+	// First processing.
+	if err := c.HandlePaymentCharged(msg); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Balance("a1"); got != 500 {
+		t.Fatalf("first balance = %d", got)
+	}
+	if got := l.Balance(SettlementAccount); got != -500 {
+		t.Fatalf("first settlement = %d", got)
+	}
+	if len(l.Entries()) != 2 {
+		t.Fatalf("expected 2 entries, got %d", len(l.Entries()))
+	}
+
+	// Duplicate processing should be idempotent.
+	if err := c.HandlePaymentCharged(msg); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Balance("a1"); got != 500 {
+		t.Fatalf("second balance = %d (should be unchanged)", got)
+	}
+	if got := l.Balance(SettlementAccount); got != -500 {
+		t.Fatalf("second settlement = %d (should be unchanged)", got)
+	}
+	if len(l.Entries()) != 2 {
+		t.Fatalf("expected still 2 entries after duplicate, got %d", len(l.Entries()))
+	}
+}
