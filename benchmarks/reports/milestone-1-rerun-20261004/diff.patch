+func TestCreatePaymentIdempotencyKey(t *testing.T) {
+	mux, prod := newTestServer()
+
+	// First request with idempotency key.
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"acc_1","amount_cents":500,"currency":"EUR"}`))
+	req.Header.Set("Idempotency-Key", "idem-1")
+	mux.ServeHTTP(rec, req)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("first request status = %d", rec.Code)
+	}
+	var firstResp store.Payment
+	if err := json.Unmarshal(rec.Body.Bytes(), &firstResp); err != nil {
+		t.Fatal(err)
+	}
+	if len(prod.Sent) != 1 {
+		t.Fatalf("expected 1 event, got %d", len(prod.Sent))
+	}
+
+	// Second request with the same idempotency key.
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"acc_1","amount_cents":500,"currency":"EUR"}`))
+	req.Header.Set("Idempotency-Key", "idem-1")
+	mux.ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("second request status = %d", rec.Code)
+	}
+	var secondResp store.Payment
+	if err := json.Unmarshal(rec.Body.Bytes(), &secondResp); err != nil {
+		t.Fatal(err)
+	}
+	if secondResp.ID != firstResp.ID {
+		t.Fatalf("payment IDs differ: %s vs %s", secondResp.ID, firstResp.ID)
+	}
+	if len(prod.Sent) != 1 {
+		t.Fatalf("expected still 1 event after duplicate, got %d", len(prod.Sent))
+	}
+
+	// Third request with a different idempotency key should create a new payment.
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"acc_1","amount_cents":500,"currency":"EUR"}`))
+	req.Header.Set("Idempotency-Key", "idem-2")
+	mux.ServeHTTP(rec, req)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("third request status = %d", rec.Code)
+	}
+	if len(prod.Sent) != 2 {
+		t.Fatalf("expected 2 events total, got %d", len(prod.Sent))
+	}
+}
+
+func TestCreatePaymentWithoutIdempotencyKey(t *testing.T) {
+	mux, prod := newTestServer()
+
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/payments", strings.NewReader(`{"account_id":"acc_1","amount_cents":500,"currency":"EUR"}`)))
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d", rec.Code)
+	}
+	if len(prod.Sent) != 1 {
+		t.Fatalf("expected 1 event, got %d", len(prod.Sent))
+	}
+}
