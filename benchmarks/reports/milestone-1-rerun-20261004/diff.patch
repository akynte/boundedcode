+package consumer
+
+import (
+	"testing"
+
+	"example.com/ledger-service/internal/ledger"
+)
+
+func TestHiddenDuplicateEvent(t *testing.T) {
+	l := &ledger.Ledger{}
+	c := &Consumer{Ledger: l}
+	msg := &ConsumerMessage{Topic: TopicPaymentCharged, Value: []byte(`{"payment_id":"p1","account_id":"a","amount_cents":500,"currency":"EUR"}`)}
+	for i := 0; i < 3; i++ {
+		if err := c.HandlePaymentCharged(msg); err != nil {
+			t.Fatalf("attempt %d: %v", i, err)
+		}
+	}
+	if l.Balance("a") != 500 || len(l.Entries()) != 2 {
+		t.Fatalf("balance=%d entries=%d", l.Balance("a"), len(l.Entries()))
+	}
+}

