index dda39bd..804701e 100644
--- a/internal/store/store.go
+++ b/internal/store/store.go
@@ -24,10 +24,11 @@ var ErrNotFound = errors.New("payment not found")
 type Store struct {
 	mu       sync.Mutex
 	payments map[string]Payment
+	idemKeys map[string]string // idempotency_key -> payment_id
 }
 
 // New returns an empty store.
-func New() *Store { return &Store{payments: map[string]Payment{}} }
+func New() *Store { return &Store{payments: map[string]Payment{}, idemKeys: map[string]string{}} }
 
 // InsertPayment runs: INSERT INTO payments (id, account_id, amount_cents, currency, status) VALUES (...)
 func (s *Store) InsertPayment(_ context.Context, p Payment) error {
@@ -47,3 +48,24 @@ func (s *Store) GetPayment(_ context.Context, id string) (Payment, error) {
 	}
 	return p, nil
 }
+
+// GetIdempotentPayment returns the payment already stored under the given key, or ErrNotFound.
+func (s *Store) GetIdempotentPayment(key string) (Payment, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	payID, ok := s.idemKeys[key]
+	if !ok {
+		return Payment{}, false
+	}
+	p, ok := s.payments[payID]
+	return p, ok
+}
+
+// RecordIdempotencyKey records the mapping so future requests with the same key
+// can be served from the cache without re-publishing events. Must be called
+// alongside InsertPayment within the same critical section in the handler.
+func (s *Store) RecordIdempotencyKey(key, paymentID string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.idemKeys[key] = paymentID
+}
